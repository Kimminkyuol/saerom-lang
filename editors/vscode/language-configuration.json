{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["{", "}"]],
  "wordPattern": "[가-힣A-Za-z0-9_]+",
  "indentationRules": {
    "increaseIndentPattern": ":\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(아니면|아니고)\\b"
  },
  "onEnterRules": [
    { "beforeText": ":\\s*(#.*)?$", "action": { "indent": "indent" } }
  ]
}
