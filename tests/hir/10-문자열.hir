globals 9
module 0 10-문자열
  (set global 0
    str 정수
  )
  (set global 1
    str 실수
  )
  (set global 2
    str 문자열
  )
  (set global 3
    str 논리값
  )
  (set global 4
    str 안녕하세요
  )
  (eval
    (call Print
      (template
        str 글자수: 
        (field 글자수
          global 4
        )
        str \n
      )
    )
  )
  (set global 5
    (call Split
      str 가,나,다
      str ,
    )
  )
  (eval
    (call Print
      (template
        str 자른 것: 
        global 5
        str   개수: 
        (field 개수
          global 5
        )
        str \n
      )
    )
  )
  (eval
    (call Print
      (template
        str 다시 이음: 
        (call JoinWith
          global 5
          str -
        )
        str \n
      )
    )
  )
  (if
    (branch
      (test
        (call Contains
          global 4
          str 안녕
        )
      )
      (body
        (eval
          (call Print
            str '안녕'을 담고 있음\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (call StartsWith
          global 4
          str 안
        )
      )
      (body
        (eval
          (call Print
            str '안'으로 시작함\n
          )
        )
      )
    )
  )
  (set global 6
    (list
      str 가
      str 나다
      str 라마바
    )
  )
  (range global 7
    (start
      int 1
    )
    (stop
      (field 개수
        global 6
      )
    )
    (body
      (set global 8
        (index
          global 6
          global 7
        )
      )
      (eval
        (call Print
          (template
            global 8
            str :
            (field 글자수
              global 8
            )
            str  
          )
        )
      )
    )
  )
  (eval
    (call Print
      str \n
    )
  )
  (eval
    (call Print
      str 탭\t끝\n
    )
  )
  (eval
    (call Print
      str 따옴표 "안"\n
    )
  )
