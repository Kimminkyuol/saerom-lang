globals 5
module 0 03-조건
  (set global 0
    str 정수
  )
  (set global 1
    str 실수
  )
  (set global 2
    str 문자열
  )
  (set global 3
    str 논리값
  )
  (set global 4
    int 20
  )
  (if
    (branch
      (test
        (call Greater
          global 4
          int 20
        )
      )
      (body
        (eval
          (call Print
            str 어른\n
          )
        )
      )
    )
    (branch
      (test
        (call Equal
          global 4
          int 20
        )
      )
      (body
        (eval
          (call Print
            str 갓 어른\n
          )
        )
      )
    )
    (otherwise
      (eval
        (call Print
          str 아이\n
        )
      )
    )
  )
  (if
    (branch
      (test
        (and
          (call Greater
            global 4
            int 10
          )
          (call Less
            global 4
            int 30
          )
        )
      )
      (body
        (eval
          (call Print
            str 20대쯤\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (or
          (call Equal
            global 4
            int 100
          )
          (call Equal
            global 4
            int 20
          )
        )
      )
      (body
        (eval
          (call Print
            str 스물이거나 백\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (not
          (call Greater
            global 4
            int 30
          )
        )
      )
      (body
        (eval
          (call Print
            str 서른 이하\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (not
          (call Equal
            global 4
            int 19
          )
        )
      )
      (body
        (eval
          (call Print
            str 열아홉이 아님\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (or
          (call Less
            global 4
            int 20
          )
          (call Equal
            global 4
            int 20
          )
        )
      )
      (body
        (eval
          (call Print
            str 스물 이하\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (not
          (call Less
            global 4
            int 20
          )
        )
      )
      (body
        (eval
          (call Print
            str 스무 살부터\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (and
          (call Greater
            global 4
            int 19
          )
          (call Less
            global 4
            int 30
          )
        )
      )
      (body
        (eval
          (call Print
            str 스물에서 스물아홉\n
          )
        )
      )
    )
  )
  (if
    (branch
      (test
        (not
          (call Greater
            global 4
            int 20
          )
        )
      )
      (body
        (eval
          (call Print
            str 스무 살까지\n
          )
        )
      )
    )
  )
