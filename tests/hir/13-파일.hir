globals 10
module 0 13-파일
  (set global 0
    str 정수
  )
  (set global 1
    str 실수
  )
  (set global 2
    str 문자열
  )
  (set global 3
    str 논리값
  )
  (with global 4
    (call Open
      str /tmp/새롬예제.txt
    )
    (body
      (eval
        (call Write
          global 4
          str 첫 줄\n
        )
      )
      (eval
        (call Write
          global 4
          str 둘째 줄\n
        )
      )
    )
  )
  (with global 5
    (call Open
      str /tmp/새롬예제2.txt
    )
    (body
      (eval
        (call Write
          global 5
          str 가나다\n
        )
      )
    )
  )
  (eval
    (call Print
      (template
        str 읽음:\n
        (call Read
          str /tmp/새롬예제.txt
        )
      )
    )
  )
  (with global 6
    (call Open
      str /tmp/새롬예제2.txt
    )
    (body
      (eval
        (call Print
          (template
            str 옛 내용: 
            (call Read
              global 6
            )
          )
        )
      )
      (eval
        (call Write
          global 6
          str 새 내용\n
        )
      )
    )
  )
  (eval
    (call Print
      (template
        str 바뀐 뒤: 
        (call Read
          str /tmp/새롬예제2.txt
        )
      )
    )
  )
  (set global 7
    (call Split
      (call Read
        str /tmp/새롬예제.txt
      )
      str \n
    )
  )
  (range global 8
    (start
      int 1
    )
    (stop
      (field 개수
        global 7
      )
    )
    (body
      (set global 9
        (index
          global 7
          global 8
        )
      )
      (if
        (branch
          (test
            (call Equal
              (field 글자수
                global 9
              )
              int 0
            )
          )
          (body
            continue
          )
        )
      )
      (eval
        (call Print
          (template
            global 8
            str : 
            global 9
            str \n
          )
        )
      )
    )
  )
